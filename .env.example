# Firebase project config (Project settings → General → Your apps → SDK setup and config).
# These values are safe to ship in the client bundle — access control comes from Firestore
# security rules (firestore.rules) and Firebase Auth, not from keeping this file secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
